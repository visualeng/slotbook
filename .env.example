# Скопируйте в .env — локальные значения по умолчанию.
# В DSN логин и пароль держать не нужно: они берутся из переменных ниже.
DATABASE_URL=postgres://localhost:5432/slotbook
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
PORT=3000

# Интеграционные тесты идут по отдельной базе и без неё молча пропускаются:
# TEST_DATABASE_URL=postgres://localhost:5432/slotbook_test
TEST_DATABASE_USER=postgres
TEST_DATABASE_PASSWORD=postgres

# Куда смотреть за собранным вебом (по умолчанию dist/web) и за миграциями.
# WEB_DIST=dist/web
# MIGRATIONS_DIR=db/migrations
